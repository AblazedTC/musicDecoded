# Local dev values for docker-compose.yml. Copy to .env (gitignored) to override.
# These are dev-only defaults; compose works without a .env at all.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres # no "@" or "/": it is inserted into DATABASE_URL without URL-encoding

# MinIO root credentials; also used as S3_ACCESS_KEY / S3_SECRET_KEY for api + worker
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

S3_BUCKET=musicdecoded

# YouTube Data API v3 key for in-app search (Google Cloud console). Never commit a real key.
YOUTUBE_API_KEY=
