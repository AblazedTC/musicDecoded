{
  "description": "Turns a chord label (Harte notation, as in analysis.schema.json) into piano notes. Both apps MUST use this table so the piano views match. Algorithm: split label at ':' into root and quality; split quality at '/' into quality and bass; root MIDI = rootOctaveBase + pitchClass[root]; notes = root + each interval of qualities[quality] (fall back to the text before '(' and then to 'maj' when unknown); if a bass is present, add bassOctaveBase + (pitchClass[root] + degree semitones) % 12 as the lowest note. Labels 'N' and 'X' = no notes.",
  "rootOctaveBase": 48,
  "bassOctaveBase": 36,
  "pitchClass": {
    "C": 0, "C#": 1, "Db": 1, "D": 2, "D#": 3, "Eb": 3, "E": 4, "Fb": 4, "E#": 5,
    "F": 5, "F#": 6, "Gb": 6, "G": 7, "G#": 8, "Ab": 8, "A": 9, "A#": 10, "Bb": 10,
    "B": 11, "Cb": 11, "B#": 0
  },
  "qualities": {
    "maj":      [0, 4, 7],
    "min":      [0, 3, 7],
    "dim":      [0, 3, 6],
    "aug":      [0, 4, 8],
    "sus2":     [0, 2, 7],
    "sus4":     [0, 5, 7],
    "sus4(b7)": [0, 5, 7, 10],
    "5":        [0, 7],
    "7":        [0, 4, 7, 10],
    "maj7":     [0, 4, 7, 11],
    "min7":     [0, 3, 7, 10],
    "minmaj7":  [0, 3, 7, 11],
    "dim7":     [0, 3, 6, 9],
    "hdim7":    [0, 3, 6, 10],
    "maj6":     [0, 4, 7, 9],
    "min6":     [0, 3, 7, 9],
    "9":        [0, 4, 7, 10, 14],
    "maj9":     [0, 4, 7, 11, 14],
    "min9":     [0, 3, 7, 10, 14],
    "11":       [0, 4, 7, 10, 14, 17],
    "min11":    [0, 3, 7, 10, 14, 17],
    "13":       [0, 4, 7, 10, 14, 21],
    "maj13":    [0, 4, 7, 11, 14, 21],
    "min13":    [0, 3, 7, 10, 14, 21]
  },
  "degreeSemitones": {
    "1": 0, "b2": 1, "2": 2, "b3": 3, "3": 4, "4": 5, "#4": 6, "b5": 6, "5": 7,
    "#5": 8, "b6": 8, "6": 9, "bb7": 9, "b7": 10, "7": 11, "b9": 13, "9": 14
  },
  "examples": {
    "A:maj":   [57, 61, 64],
    "D:maj/3": [42, 50, 54, 57],
    "F#:min7": [54, 57, 61, 64],
    "N":       []
  }
}
